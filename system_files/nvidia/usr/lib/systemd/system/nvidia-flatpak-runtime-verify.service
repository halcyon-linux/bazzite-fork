[Unit]
Description=Verify NVIDIA system drivers are synced with Flatpak runtime
After=graphical.target xdg-desktop-autostart.target xdg-desktop-portal.service nvidia-flatpak-runtime-sync.service
ConditionPathExists=/sys/module/nvidia/version
ConditionPathExists=/run/ostree-booted

[Service]
Type=oneshot
ExecCondition=/usr/bin/nvidia-flatpak-runtime-sync check
ExecStartPre=/bin/sleep 5
ExecStart=/usr/bin/nvidia-flatpak-runtime-notify
RemainAfterExit=yes
Restart=on-failure
RestartSec=30
TimeoutStartSec=600

[Install]
WantedBy=graphical.target
