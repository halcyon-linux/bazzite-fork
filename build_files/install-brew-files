#!/usr/bin/env bash

set -Eeuo pipefail

source_dir=/tmp/brew_files
file_list=/tmp/brew_list.txt

if [[ ! -d "$source_dir" ]]; then
    printf 'Homebrew source tree not found: %s\n' "$source_dir" >&2
    exit 1
fi

cleanup_staging() {
    rm -f "$file_list"
    rm -rf "$source_dir"
}
trap cleanup_staging EXIT

find "$source_dir" -type f -printf '/%P\0' > "$file_list"
cp -a "$source_dir"/. /
xargs -0 -r -a "$file_list" setfattr -h -n user.component -v homebrew 2>/dev/null || true
