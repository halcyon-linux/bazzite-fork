#!/usr/bin/env bash

set -Eeuo pipefail

# Download reference DXVK configuration.
install -d /etc
/ctx/ghcurl \
    'https://raw.githubusercontent.com/doitsujin/dxvk/3a4c6fa3cb1548d56a90a38dd8f526b6c13e63fd/dxvk.conf' \
    -Lo /etc/dxvk-example.conf

# Download the Waydroid GPU chooser.
install -d /usr/bin
/ctx/ghcurl \
    'https://raw.githubusercontent.com/ublue-os/waydroid-scripts/main/waydroid-choose-gpu.sh' \
    -Lo /usr/bin/waydroid-choose-gpu
chmod +x /usr/bin/waydroid-choose-gpu

# Configure DNF5 to skip unavailable repositories.
dnf5 config-manager setopt skip_if_unavailable=1

# Download Distrobox Docker and Incus template configurations.
install -d /etc/distrobox
/ctx/ghcurl \
    'https://github.com/ublue-os/toolboxes/raw/refs/heads/main/apps/docker/distrobox.ini' \
    -Lo /etc/distrobox/docker.ini
setfattr -n user.component -v 'toolbox-config' /etc/distrobox/docker.ini 2>/dev/null || true

/ctx/ghcurl \
    'https://github.com/ublue-os/toolboxes/raw/refs/heads/main/apps/incus/distrobox.ini' \
    -Lo /etc/distrobox/incus.ini
setfattr -n user.component -v 'toolbox-config' /etc/distrobox/incus.ini 2>/dev/null || true

# Download the bash-preexec shell hook.
install -d /usr/share
/ctx/ghcurl \
    'https://raw.githubusercontent.com/ublue-os/bash-preexec/master/bash-preexec.sh' \
    -Lo /usr/share/bash-prexec
setfattr -n user.component -v 'bash-preexec' /usr/share/bash-prexec 2>/dev/null || true
ln -sfn /usr/share/bash-prexec /usr/share/bash-preexec
