#!/usr/bin/env bash

set -Eeuo pipefail

# Remove the toolbox shell profile and prepare /var/tmp.
rm -f /etc/profile.d/toolbox.sh
mkdir -p /var/tmp
chmod 1777 /var/tmp

# Symlink Direct Rendering Manager libraries.
if [[ -e /usr/lib/libdrm.so.2 ]]; then
    cp --no-dereference --preserve=links /usr/lib/libdrm.so.2 /usr/lib/libdrm.so
fi
if [[ -e /usr/lib64/libdrm.so.2 ]]; then
    cp --no-dereference --preserve=links /usr/lib64/libdrm.so.2 /usr/lib64/libdrm.so
fi

# Wrap Steam launchers and add a silent autostart entry for new users.
if [[ -f /usr/share/applications/steam.desktop ]]; then
    sed -i 's@/usr/bin/steam@/usr/bin/bazzite-steam@g' /usr/share/applications/steam.desktop
    sed -i 's@Exec=steam steam://open/bigpicture@Exec=/usr/bin/bazzite-steam-bpm@g' /usr/share/applications/steam.desktop
    mkdir -p /etc/skel/.config/autostart/
    cp /usr/share/applications/steam.desktop /etc/skel/.config/autostart/steam.desktop
    sed -i 's@/usr/bin/bazzite-steam %U@/usr/bin/bazzite-steam -silent %U@g' \
        /etc/skel/.config/autostart/steam.desktop
fi

# Hide CLI utilities from graphical application menus.
for app in nvtop btop yad-icon-browser; do
    if [[ -f "/usr/share/applications/${app}.desktop" ]]; then
        desktop-file-edit --set-key=Hidden --set-value=true "/usr/share/applications/${app}.desktop"
    fi
done

# Enable UserspaceHID for Bluetooth gamepads and patch GRUB's OSTree device probing.
if [[ -f /etc/bluetooth/input.conf ]]; then
    sed -i 's/#UserspaceHID.*/UserspaceHID=true/' /etc/bluetooth/input.conf
fi
if [[ -f /usr/bin/grub2-mkconfig ]]; then
    sed -i "s|grub_probe\} --target=device /\`|grub_probe} --target=device /sysroot\`|g" \
        /usr/bin/grub2-mkconfig
fi

# Remove systemd keep-warm configuration.
rm -f /usr/lib/systemd/system/service.d/50-keep-warm.conf
