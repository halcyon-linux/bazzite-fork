#!/usr/bin/env bash

set -Eeuo pipefail

mkdir -p /usr/share/ublue-os
touch /usr/share/ublue-os/justfile

justfiles=(
    "80-bazzite.just"
    "81-bazzite-fixes.just"
    "82-bazzite-apps.just"
    "82-bazzite-cockpit.just"
    "82-bazzite-beesd.just"
    "82-bazzite-waydroid.just"
    "83-bazzite-audio.just"
    "85-bazzite-image.just"
    "84-bazzite-virt.just"
    "86-bazzite-windows.just"
    "87-bazzite-framegen.just"
    "89-bazzite-mesa-git.just"
    "90-bazzite-picker.just"
    "92-bazzite-verify.just"
    "93-bazzite-update.just"
)

for jf in "${justfiles[@]}"; do
    line="import \"/usr/share/ublue-os/just/${jf}\""
    if ! grep -qxF "$line" /usr/share/ublue-os/justfile 2>/dev/null; then
        echo "$line" >> /usr/share/ublue-os/justfile
    fi
done
